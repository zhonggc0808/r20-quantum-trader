[Unit]
Description=R20 Quantum Trader Standalone Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/root/.okx/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PATH=/root/.local/bin:/root/.okx/bin:/root/development/r20-quantum-trader/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/root/development/r20-quantum-trader
EnvironmentFile=/root/development/r20-quantum-trader/.env
ExecStart=/root/development/r20-quantum-trader/.venv/bin/python -m uvicorn r20_backend.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
