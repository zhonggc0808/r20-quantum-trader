[Unit]
Description=R20 Quantum Trader Standalone Scheduler
After=network-online.target
Conflicts=r20-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/development/r20-account-isolation
EnvironmentFile=/root/development/r20-account-isolation/.env
ExecStart=/root/development/r20-account-isolation/.venv/bin/python -m r20_backend.scheduler
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
