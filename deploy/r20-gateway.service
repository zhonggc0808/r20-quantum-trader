[Unit]
Description=R20 Quantum Trader Gateway Worker
After=network.target

[Service]
Type=simple
User=r20
Group=r20
Environment=HOME=/home/r20
Environment=PATH=/opt/r20-account-isolation/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/r20-account-isolation
EnvironmentFile=/opt/r20-account-isolation/.env
ExecStart=/opt/r20-account-isolation/.venv/bin/python -m r20_gateway.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
